{
  "entities": {
    "RapSong": {
      "title": "Rap Song",
      "description": "A saved rap lyric project.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "User ID of the owner"
        },
        "title": {
          "type": "string",
          "description": "Title of the song"
        },
        "sectionsJson": {
          "type": "string",
          "description": "Stringified JSON of sections"
        },
        "audioName": {
          "type": "string",
          "description": "Name of the beat"
        },
        "localBeatId": {
          "type": "string",
          "description": "ID used to retrieve beat from IndexedDB"
        },
        "googleDocId": {
          "type": "string",
          "description": "Google Doc ID if exported"
        },
        "createdAt": {
          "type": "timestamp"
        },
        "updatedAt": {
          "type": "timestamp"
        }
      },
      "required": ["ownerId", "title", "sectionsJson", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "songs/{songId}": {
      "schema": "RapSong",
      "description": "Collection of user's rap songs"
    }
  }
}
