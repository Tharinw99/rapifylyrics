rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    function isValidRapSong(data) {
      return data.keys().hasAll(['ownerId', 'title', 'createdAt', 'updatedAt'])
        && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && ( !('docType' in data) || data.docType in ['song', 'plan', 'album'] )
        && ( !('sectionsJson' in data) || (data.sectionsJson is string && data.sectionsJson.size() <= 500000) )
        && ( !('contentJson' in data) || (data.contentJson is string && data.contentJson.size() <= 500000) )
        && ( !('audioName' in data) || (data.audioName is string && data.audioName.size() <= 200) )
        && ( !('localBeatId' in data) || (data.localBeatId is string && data.localBeatId.size() <= 200) )
        && ( !('googleDocId' in data) || (data.googleDocId is string && data.googleDocId.size() <= 200) )
        && ( !('coverUrl' in data) || (data.coverUrl is string && data.coverUrl.size() <= 2000) );
    }

    match /songs/{songId} {
      allow get: if isSignedIn() && isValidId(songId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(songId) 
        && isValidRapSong(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      
      allow update: if isSignedIn() && isValidId(songId) 
        && isValidRapSong(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'docType', 'sectionsJson', 'contentJson', 'audioName', 'localBeatId', 'googleDocId', 'coverUrl', 'updatedAt']);
        
      allow delete: if isSignedIn() && isValidId(songId) && existing().ownerId == request.auth.uid;
    }
  }
}
